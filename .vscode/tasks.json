{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start JavaFX Debug",
            "type": "shell",
            "command": "./mvnw",
            "windows": {
                "command": "mvnw.cmd"
            },
            "osx": {
                "command": "./mvnw"
            },
            "linux": {
                "command": "./mvnw"
            },
            "args": [
                "javafx:run@debug"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "beginsPattern": ".*",
                    "endsPattern": "Listening for transport dt_socket at address: 8000"
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            }
        }
    ]
}
